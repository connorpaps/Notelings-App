# Dependencies
node_modules/

# Next.js build output
.next/
out/

# TypeScript incremental build info
tsconfig.tsbuildinfo

# Environment files (never commit secrets)
.env
.env.local
.env*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Playwright test artifacts
test-results/
playwright-report/

# Auto-memory local watcher log (raw per-save events; the commit log is tracked)
docs/activity-watch.log

# Local machine marker (hostname of the last machine the repo was used on)
docs/.last-machine

# Performance comparison artifacts (generated locally; never commit)
docs/.performance-artifacts/

# Dev-server launcher state (scripts/dev-server.sh)
docs/.dev-server.log
docs/.dev-server.pid
