# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# Google Gemini API key (used by @ai-sdk/google for note categorization and
# the "Ask the Librarian" chat).
GOOGLE_GENERATIVE_AI_API_KEY=

# Supabase project URL (public — safe to expose in the browser bundle).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — used for Auth and owner-scoped Realtime in the
# browser. RLS, not key secrecy, protects private rows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — SERVER ONLY (bypasses RLS).
# Never prefix with NEXT_PUBLIC_ and never import from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Shared demo workspace credentials — SERVER ONLY. POST /api/auth/demo signs
# the cookie session into this account (created by scripts/setup-auth-db.mjs).
# Configure these only in the separate portfolio-demo deployment/local demo.
# Optional; without them the demo entry point returns 503.
NOTELINGS_DEMO_EMAIL=
NOTELINGS_DEMO_PASSWORD=

# Optional local/test renderer override. Do not set the E2E auth bypass in any
# Vercel Preview or Production environment.
NEXT_PUBLIC_NOTELINGS_RENDER_QUALITY=auto

# Local-only demo reset guard. Do not configure these in the private workspace.
# The reset script refuses to run unless the ref matches the demo Supabase URL
# and NOTELINGS_DEMO_RESET_CONFIRM=RESET_DEMO is set explicitly.
NOTELINGS_DEMO_PROJECT_REF=
NOTELINGS_DEMO_RESET_CONFIRM=
