# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# Google Gemini API key (used by @ai-sdk/google for note categorization and
# the "Ask the Librarian" chat).
GOOGLE_GENERATIVE_AI_API_KEY=

# Supabase project URL (public — safe to expose in the browser bundle).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — used ONLY for the Realtime subscription in the
# browser. Read-only by design; never use it for writes.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — SERVER ONLY (bypasses RLS).
# Never prefix with NEXT_PUBLIC_ and never import from a client component.
SUPABASE_SERVICE_ROLE_KEY=
