# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# Google Gemini API key (used by @ai-sdk/google for note categorization and
# the "Ask the Librarian" chat).
GOOGLE_GENERATIVE_AI_API_KEY=

# Unified one-Vercel deployment: the root uses PRIVATE_* and /demo uses DEMO_*.
# Service-role keys are SERVER ONLY and must never be imported by client code.
PRIVATE_SUPABASE_URL=
PRIVATE_SUPABASE_ANON_KEY=
PRIVATE_SUPABASE_SERVICE_ROLE_KEY=
DEMO_SUPABASE_URL=
DEMO_SUPABASE_ANON_KEY=
DEMO_SUPABASE_SERVICE_ROLE_KEY=

# Public anon config for browser Auth and owner-scoped Realtime. RLS, not key
# secrecy, protects rows; anon keys are safe to expose in the browser bundle.
NEXT_PUBLIC_PRIVATE_SUPABASE_URL=
NEXT_PUBLIC_PRIVATE_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEMO_SUPABASE_URL=
NEXT_PUBLIC_DEMO_SUPABASE_ANON_KEY=

# Temporary private-mode compatibility names. Remove after the unified Vercel
# environment is verified; never use these as the demo configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared demo workspace credentials — SERVER ONLY. POST /demo/api/auth/demo signs
# the cookie session into this account (created by scripts/setup-auth-db.mjs).
# Configure these in the unified Vercel project for demo mode.
NOTELINGS_DEMO_EMAIL=
NOTELINGS_DEMO_PASSWORD=

# Optional local/test renderer override. Do not set the E2E auth bypass in any
# Vercel Preview or Production environment.
NEXT_PUBLIC_NOTELINGS_RENDER_QUALITY=auto

# Local-only demo reset guard. Do not configure these in the private workspace.
# The reset script refuses to run unless the ref matches the demo Supabase URL
# and NOTELINGS_DEMO_RESET_CONFIRM=RESET_DEMO is set explicitly.
NOTELINGS_DEMO_PROJECT_REF=
NOTELINGS_DEMO_RESET_CONFIRM=
